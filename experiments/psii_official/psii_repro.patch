+def apply_vector_control(vectors, mode, seed):
+    """[reproduction patch] zero / random-direction control with identical layers and norms."""
+    out = []
+    for vec, layer_idx in vectors:
+        if mode == "zero":
+            out.append((torch.zeros_like(vec), layer_idx))
+        else:
+            key = int(vec.double().abs().sum().item() * 1e6) % (2**31)
+            g = torch.Generator().manual_seed((seed or 0) * 1000003 + key)
+            r = torch.randn(vec.shape, generator=g, dtype=torch.float32)
+            r = r / r.norm() * vec.float().norm()
+            out.append((r.to(vec.dtype), layer_idx))
+    return out
+
